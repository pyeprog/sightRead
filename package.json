    "configuration": {
      "title": "SightRead",
      "properties": {
        "sightread.guide.harness": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Which coding-agent CLI interprets functions. Accepted values:\n- `auto` *(default)* — probes the PATH and takes the first hit, in market-share order: `claude` → `codex` → `opencode` → `pi` → `cursor` → `aider` → `agy` (running inside Cursor promotes `cursor` to the front)\n- a builtin harness name: `claude`, `codex`, `opencode`, `pi`, `cursor`, `aider`, `agy`\n- the name of an entry in `#sightread.guide.customHarnesses#`"
        },
        "sightread.guide.customHarnesses": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra harness profiles, or wholesale replacements of builtin ones (same name wins). Each value is an object with:\n- `command` — the executable\n- `args` — argument array; `${prompt}` is replaced with the full prompt (omit it to pipe the prompt via stdin)\n- `env` — extra environment variables *(optional)*\n- `resultField` — field of a JSON-envelope stdout holding the final text *(optional; omit for CLIs that print the plain answer)*\n- `errorField` — envelope field that is `true` on failure *(optional)*\n\nExample:\n```json\n{ \"mytool\": { \"command\": \"mytool\", \"args\": [\"run\", \"${prompt}\"] } }\n```"
        },
        "sightread.guide.language": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language of the notes and summary in AI-generated guides (e.g. `简体中文`, `Japanese`, `Deutsch`). Empty = English."
        },
        "sightread.guide.promptTemplate.function": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Custom reading instructions when interpreting a **function**.\n\nEmpty = builtin default: structure roles (main / setup / fallback / special), plus the existence-reason of at most 9 core entities.\n\nPlaceholders:\n- `${filePath}` — file path relative to the workspace\n- `${languageId}` — programming language\n- `${subjectName}` — the function's name\n- `${subjectText}` — its source with absolute line numbers\n- `${fileHeader}` — the file's import region\n- `${userNote}` — what you type into the per-run focus box\n\nThe JSON output contract is appended by SightRead after the template and always wins on conflict."
        },
        "sightread.guide.promptTemplate.class": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Custom reading instructions when interpreting a **class**.\n\nEmpty = builtin default: one step per member, role-tagged (entry / helper / util / lifecycle / state), notes give the member's reason to exist.\n\nSame placeholders as `#sightread.guide.promptTemplate.function#` — `${subjectName}` / `${subjectText}` are the class's name and source.\n\nThe JSON output contract is appended by SightRead and always wins on conflict."
        },
        "sightread.guide.promptTemplate.file": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Custom reading instructions when interpreting a whole **file**.\n\nEmpty = builtin default: one step per top-level block, role-tagged (config / types / core / wiring / util / exports), notes give the block's reason to exist.\n\nSame placeholders as `#sightread.guide.promptTemplate.function#` — `${subjectName}` / `${subjectText}` are the file's basename and source.\n\nThe JSON output contract is appended by SightRead and always wins on conflict."
        },
        "sightread.variableTint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Outline all occurrences of the symbol under the cursor within the enclosing function (reads blue, writes orange)."
        },
        "sightread.spotlight.defaultMode": {
          "type": "string",
          "enum": [
            "off",
            "seg+var",
            "seg",
            "fn"
          ],
          "enumDescriptions": [
            "Off — no dimming",
            "Segment+Variable — segment focus, plus segments touched by the symbol under the cursor stay lit",
            "Segment — dim non-current segments inside the function as well as everything outside it",
            "Function — dim everything outside the current function"
          ],
          "default": "off",
          "description": "Spotlight level applied on startup."
        },
        "sightread.spotlight.functionDimOpacity": {
          "type": "number",
          "default": 0.15,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of code outside the current function while the spotlight is on."
        },
        "sightread.spotlight.segmentDimOpacity": {
          "type": "number",
          "default": 0.4,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of non-related parts of the current function (spotlight level 2+)."
        },
        "sightread.spotlight.siblingDimOpacity": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of sibling segments of the cursor's segment (spotlight level 2+)."
        },
        "sightread.entries.languageHints": {
          "type": "boolean",
          "default": true,
          "description": "Use language syntax (export/pub keywords, Go capitalization, leading-underscore naming) to classify symbols that have no references anywhere: declared-public ones become entries, declared-private ones are dropped."
        },
        "sightread.entries.showSuspected": {
          "type": "boolean",
          "default": true,
          "description": "Show suspected entries — symbols with no references found anywhere. These may be framework-invoked entries (activation hooks, route handlers) or dead code."
        },
        "sightread.entries.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Mark entry points with a gutter icon in the editor."
        },
        "sightread.entries.iconColor": {
          "type": "string",
          "default": "#8C8C8C",
          "description": "Color of the entry-point gutter chevrons (any CSS color, e.g. #3794FF). Suspected entries use the same color at reduced opacity."
        },
        "sightread.marker.favoriteColor": {
          "type": "string",
          "enum": [
            "yellow",
            "red",
            "green",
            "blue",
            "purple"
          ],
          "default": "yellow",
          "description": "Color used by \"Mark Selection (Favorite Color)\" — the one-click bookmark button on the Markers view and in the editor context menu."
        },
        "sightread.marker.notePosition": {
          "type": "string",
          "enum": [
            "lineStart",
            "lineEnd"
          ],
          "default": "lineEnd",
          "description": "Where a marker's note is rendered on the first marked line. lineStart shifts the code of that line to the right."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.16.0",
    "mocha": "^10.8.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2"
  }
}
