      "sightread": [
        {
          "id": "sightread.entriesView",
          "name": "Entry Points",
          "icon": "$(sign-in)"
        },
        {
          "id": "sightread.segmentsView",
          "name": "Segments",
          "icon": "$(list-tree)"
